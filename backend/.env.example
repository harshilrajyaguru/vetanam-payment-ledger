# Server
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/payment_ledger?replicaSet=rs0

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Rate limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_TRANSFER_MAX=30
RATE_LIMIT_TRANSFER_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=100
RATE_LIMIT_READ_WINDOW_MS=60000

# Fraud detection (defaults for later phases)
FRAUD_AMOUNT_THRESHOLD=1000000
FRAUD_VELOCITY_MAX=5
FRAUD_NEW_ACCOUNT_DAYS=7
FRAUD_FLAG_SCORE=60
FRAUD_BLOCK_SCORE=85

# Logging
LOG_LEVEL=info

# Worker
WORKER_ENABLED=false
WORKER_CONCURRENCY=5
RECONCILIATION_CRON=0 */6 * * *

# Seed (development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SYSTEM_TREASURY_ACCOUNT_ID=
